@model List<Books.Mvc.Models.Book>

@{
    ViewData["Title"] = "Книги";
}

<h1>Книги</h1>


<a asp-action="Create"
   class="btn btn-success mb-3">
    Добавить книгу
</a>

<table class="table">
    <thead>
        <tr>
            <th>Название</th>
            <th>Автор</th>
            <th>Год издания</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.YearPublished</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@book.Id"
                       class="btn btn-primary">
                        Подробнее
                    </a>
                    <a asp-action="Edit"
                       asp-route-id="@book.Id"
                       class="btn btn-warning">
                        Изменить
                    </a>
                    <form asp-action="Delete"
                          asp-route-id="@book.Id"
                          method="post"
                          style="display:inline">

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Удалить книгу?')">
                            Удалить
                        </button>

                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>